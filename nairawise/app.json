{
  "expo": {
    "name": "nairawise",
    "slug": "nairawise",
    "scheme": "nairawise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/nairawise-logo-rounded.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow NairaWise to use speech recognition to add transactions by voice.",
        "NSMicrophoneUsageDescription": "Allow NairaWise to use the microphone to add transactions by voice."
      },
      "bundleIdentifier": "com.ademolawaliyu.nairawise"
    },
    "android": {
       "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/nairawise-logo-rounded.png",
        "backgroundImage": "./assets/nairawise-logo-rounded.png",
        "monochromeImage": "./assets/nairawise-logo-rounded.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.codequor.nairawise"
    },
    "web": {
      "favicon": "./assets/nairawise-logo-rounded.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow NairaWise to use the microphone to add transactions by voice.",
          "speechRecognitionPermission": "Allow NairaWise to use speech recognition to add transactions by voice.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d0add72-14fe-425a-8699-c25eb52e1708"
      }
    }
  }
}
